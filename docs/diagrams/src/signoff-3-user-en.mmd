  classDef step fill:#fbfcfe,stroke:#9aa4b2,stroke-width:1.1px,color:#1f2937
  classDef warn fill:#fef3c7,stroke:#d97706,stroke-width:1.2px,color:#7c2d12
  classDef env fill:#eef2ff,stroke:#4f46e5,stroke-width:1.1px,color:#312e81
  classDef bad fill:#fee2e2,stroke:#b91c1c,stroke-width:1.3px,color:#7f1d1d
  class T0a,T1a,T2a,T3a,T3b stage
  class T1c,T2b,T2c,T4a,T4b,T4c must
  class T0b,T0c,T1b,T2d,T2e,T3c,T3d,T3e,T4d,T4e,T4f,T4g,T5a,T5b,T5c step
